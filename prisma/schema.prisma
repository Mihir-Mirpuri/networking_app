generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                         String                       @id @default(cuid())
  name                       String?
  email                      String?                      @unique
  emailVerified              DateTime?
  image                      String?
  classification             String?
  major                      String?
  university                 String?
  career                     String?
  onboardingCompleted        Boolean                      @default(false)
  dailySendCount             Int                          @default(0)
  lastSendDate               DateTime?
  calendarConnected          Boolean                      @default(false)
  // Credit system fields
  emailCredits               Int                          @default(0)
  apolloCallsMade            Int                          @default(0)
  referralCode               String?                      @unique
  referredById               String?
  referralLinkId             String?
  // Stripe subscription fields
  stripeCustomerId           String?                      @unique
  stripeSubscriptionId       String?                      @unique
  stripeCurrentPeriodEnd     DateTime?
  subscriptionStatus         String?
  timezone                   String? // e.g., "America/Chicago"
  emailInstructions          String? // Free-text custom instructions for LLM email generation
  autoPersonalize            Boolean                      @default(false) // Auto-personalize emails with AI when opening review modal
  referredBy                 User?                        @relation("Referrals", fields: [referredById], references: [id])
  referrals                  User[]                       @relation("Referrals")
  referralLink               ReferralLink?                @relation("UserReferralLink", fields: [referralLinkId], references: [id])
  referralLinksCreated       ReferralLink[]               @relation("ReferralLinkCreator")
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  accounts                   Account[]
  emailTemplates             EmailTemplate[]
  scheduledEmails            ScheduledEmail[]
  sendLogs                   SendLog[]
  sessions                   Session[]
  userCandidates             UserCandidate[]
  userResumes                UserResume[]
  gmailSyncState             gmail_sync_state?
  conversations              conversations[]
  messages                   messages[]
  outreachTrackers           OutreachTracker[]
  ExtractedMeetingSuggestion ExtractedMeetingSuggestion[]
  searchLogs                 SearchLog[]
  invitations                Invitation[]
  groqUsageLogs              GroqUsageLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Person {
  id                      String                       @id @default(cuid())
  fullName                String
  firstName               String?
  lastName                String?
  company                 String
  role                    String?
  linkedinUrl             String?
  email                   String?
  emailStatus             EmailStatus?
  emailConfidence         Float?
  emailLastUpdated        DateTime?
  emailDeliverable        Boolean? // Emailable verification result (null = unchecked)
  emailVerifiedAt         DateTime? // When Emailable last verified this email
  emailVerificationReason String? // Emailable reason (e.g., "accepted_email", "invalid_domain")
  apolloEnrichedAt        DateTime? // Track when Apollo data was last fetched (legacy)
  apolloStatus            ApolloStatus? // Track the result of the last Apollo call (legacy)
  scrapedAt               DateTime? // Track when LinkedIn data was last scraped
  city                    String?
  state                   String?
  country                 String?
  educationSchool         String?
  educationDegree         String?
  educationField          String?
  educationYear           String?
  schools                 Json? // Array of all schools (normalized)
  experienceHistory       Json? // Full work history from LinkedIn [{ position, companyName, location }]
  educationHistory        Json? // Full education from LinkedIn [{ schoolName, degree, fieldOfStudy }]
  role_embedding          Unsupported("vector(1536)")? // pgvector embedding for semantic role matching
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  sourceLinks             SourceLink[]
  userCandidates          UserCandidate[]
  searchPeople            SearchPerson[]
  insights                PersonInsight[]

  @@unique([fullName, company])
  @@index([fullName, company])
  @@index([emailStatus])
  @@index([apolloEnrichedAt]) // For TTL queries (legacy)
  @@index([apolloStatus]) // For filtering by enrichment status (legacy)
  @@index([scrapedAt]) // For TTL queries - check if data is stale
  @@index([linkedinUrl]) // For cache lookup by LinkedIn URL
}

model Search {
  id                    String         @id @default(cuid())
  name                  String?
  company               String?
  role                  String?
  university            String?
  location              String?
  queryHash             String? // SHA-256 hash of exact Serper query string for dedup
  // Scrape progress tracking
  lastCsePageScraped    Int            @default(0) // Now stores Serper page number (1,2,3...) not CSE start offset
  cseExhausted          Boolean        @default(false) // true when exhaustion detected
  // API usage stats (analytics)
  apolloCallsMade       Int            @default(0)
  apolloCacheHits       Int            @default(0)
  cseCallsMade          Int            @default(0)
  linkedinScraperCalls  Int            @default(0)
  profilesAdded         Int            @default(0) // New Person records created
  profilesMatchedSearch Int            @default(0) // Of those added, how many matched role/uni/location filters
  prescrapeStatus       String? // null=not started, 'RUNNING'=in progress, 'DONE'=completed
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt
  searchPeople          SearchPerson[] // Kept for production compatibility — no longer used by new code

  @@index([createdAt])
  @@index([completedAt])
  @@index([queryHash])
  @@index([company, name, role, university, location]) // Composite for param lookup
}

model SearchPerson {
  id        String   @id @default(cuid())
  searchId  String
  personId  String
  createdAt DateTime @default(now())
  search    Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([searchId, personId])
  @@index([searchId])
  @@index([personId])
}

model UserCandidate {
  id                   String           @id @default(cuid())
  userId               String
  personId             String
  email                String?
  emailStatus          EmailStatus      @default(MISSING)
  emailConfidence      Float?
  manualEmailConfirmed Boolean          @default(false)
  doNotShow            Boolean          @default(false)
  university           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  emailDraft           EmailDraft?
  scheduledEmails      ScheduledEmail[]
  sendLogs             SendLog[]
  person               Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreachTracker      OutreachTracker?

  @@unique([userId, personId])
  @@index([userId])
  @@index([personId])
  @@index([emailStatus])
  @@index([university])
  @@index([userId, doNotShow])
}

model SourceLink {
  id        String         @id @default(cuid())
  personId  String
  kind      SourceLinkKind
  url       String
  title     String
  snippet   String?
  domain    String?
  createdAt DateTime       @default(now())
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, url])
  @@index([personId])
  @@index([kind])
}

model UserResume {
  id                 String           @id @default(cuid())
  userId             String
  filename           String
  fileUrl            String
  fileSize           Int
  mimeType           String
  version            Int              @default(1)
  isActive           Boolean          @default(false)
  summary            String?
  summaryGeneratedAt DateTime?
  uploadedAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  emailDrafts        EmailDraft[]
  emailTemplates     EmailTemplate[]
  scheduledEmails    ScheduledEmail[]
  sendLogs           SendLog[]
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model EmailTemplate {
  id           String       @id @default(cuid())
  userId       String
  name         String
  prompt       String
  isDefault    Boolean      @default(false)
  attachResume Boolean      @default(false)
  resumeId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  emailDrafts  EmailDraft[]
  resume       UserResume?  @relation(fields: [resumeId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([resumeId])
}

model EmailDraft {
  id              String           @id @default(cuid())
  userCandidateId String           @unique
  templateId      String?
  subject         String
  body            String
  status          EmailDraftStatus @default(PENDING)
  userEdited      Boolean          @default(false)
  editedSubject   String?
  editedBody      String?
  attachResume    Boolean          @default(false)
  resumeId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resume          UserResume?      @relation(fields: [resumeId], references: [id])
  template        EmailTemplate?   @relation(fields: [templateId], references: [id])
  userCandidate   UserCandidate    @relation(fields: [userCandidateId], references: [id], onDelete: Cascade)

  @@index([userCandidateId])
  @@index([templateId])
  @@index([status])
  @@index([resumeId])
}

model SendLog {
  id                   String           @id @default(cuid())
  userId               String
  userCandidateId      String?
  toEmail              String
  subject              String
  body                 String
  resumeAttached       Boolean          @default(false)
  resumeId             String?
  status               SendLogStatus
  errorMessage         String?
  gmailMessageId       String?          @unique
  gmailThreadId        String?
  sentAt               DateTime         @default(now())
  directRecipientEmail String?
  directRecipientName  String?
  outreachTrackerId    String?
  resume               UserResume?      @relation(fields: [resumeId], references: [id])
  userCandidate        UserCandidate?   @relation(fields: [userCandidateId], references: [id], onDelete: Cascade)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             messages[]
  outreachTracker      OutreachTracker? @relation("OutreachSendLogs", fields: [outreachTrackerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userCandidateId])
  @@index([status])
  @@index([sentAt])
  @@index([gmailMessageId])
  @@index([gmailThreadId])
  @@index([outreachTrackerId])
}

model ScheduledEmail {
  id              String               @id @default(cuid())
  userId          String
  userCandidateId String
  toEmail         String
  subject         String
  body            String
  resumeId        String?
  scheduledFor    DateTime
  status          ScheduledEmailStatus @default(PENDING)
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  resume          UserResume?          @relation(fields: [resumeId], references: [id])
  userCandidate   UserCandidate        @relation(fields: [userCandidateId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([scheduledFor])
}

enum EmailStatus {
  MISSING
  UNVERIFIED
  VERIFIED
  MANUAL
}

enum ApolloStatus {
  SUCCESS // Apollo returned data (person found, even if no email)
  NOT_FOUND // Apollo couldn't find the person
  API_ERROR // Apollo API failed (rate limit, out of credits, network error)
  SKIPPED // Apollo call was skipped (no API key, missing required fields)
}

enum SourceLinkKind {
  DISCOVERY
  RESEARCH
}

enum SendLogStatus {
  SUCCESS
  FAILED
}

enum EmailDraftStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
}

enum ScheduledEmailStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  SIGNED_UP
}

model Invitation {
  id             String           @id @default(cuid())
  referrerId     String
  inviteeEmail   String
  status         InvitationStatus @default(PENDING)
  creditsAwarded Int              @default(0)
  sentAt         DateTime         @default(now())
  signedUpAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, inviteeEmail])
  @@index([inviteeEmail])
  @@index([status])
}

enum OutreachStatus {
  NOT_STARTED
  SENT
  WAITING
  RESPONDED
  SCHEDULED_CALL
  HAD_CALL
  GHOSTED
  NOT_INTERESTED
  CONNECTED
}

enum InteractionType {
  NONE
  PHONE
  VIDEO
  COFFEE_CHAT
  IN_PERSON
  OTHER
}

model gmail_sync_state {
  id               String    @id @default(cuid())
  userId           String    @unique
  email_address    String
  historyId        String?
  watch_expiration DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email_address])
}

model processed_notifications {
  id        String   @id @default(cuid())
  userId    String
  historyId String
  createdAt DateTime @default(now())

  @@unique([userId, historyId])
  @@index([createdAt])
}

model conversations {
  threadId      String     @id
  userId        String
  subject       String?
  lastMessageAt DateTime?
  messageCount  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      messages[]

  @@unique([userId, threadId])
  @@index([userId])
  @@index([userId, lastMessageAt])
}

enum MessageDirection {
  SENT
  RECEIVED
}

enum MeetingSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model ExtractedMeetingSuggestion {
  id            String                  @id @default(cuid())
  userId        String
  messageId     String                  @unique
  status        MeetingSuggestionStatus @default(PENDING)
  extractedData Json
  confidence    Float
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message messages @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

model messages {
  messageId                  String                      @id
  threadId                   String
  userId                     String
  direction                  MessageDirection
  sender                     String
  recipient_list             Json
  subject                    String?
  body_html                  String?
  body_text                  String?
  received_at                DateTime
  sendLogId                  String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  conversation               conversations               @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendLog                    SendLog?                    @relation(fields: [sendLogId], references: [id], onDelete: SetNull)
  ExtractedMeetingSuggestion ExtractedMeetingSuggestion?

  @@index([threadId])
  @@index([userId])
  @@index([userId, threadId])
  @@index([userId, received_at])
  @@index([sender])
  @@index([sendLogId])
}

model CompanyEmailPattern {
  id                String   @id @default(cuid())
  company           String // normalized company name (lowercase, no punctuation)
  domain            String // email domain (e.g., "zs.com")
  pattern           String // pattern type: "first.last", "firstlast", "flast", "f.last", "first_last", "first"
  confidence        Float // 0-1 based on consistency
  sampleSize        Int // number of emails used to determine pattern
  acceptAll         Boolean? // true = catch-all domain (can't verify individual emails), false = can verify, null = unchecked
  unverifiable      Boolean  @default(false) // true = SMTP blocks verification (unavailable_smtp), trust pattern
  searchable        Boolean  @default(false) // true = users can search this company
  useApolloFallback Boolean  @default(false) // true = inconsistent patterns, call Apollo per-person
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([company, domain])
  @@index([company])
  @@index([searchable])
}

model SearchLog {
  id           String   @id @default(cuid())
  userId       String
  company      String?
  role         String?
  university   String?
  location     String?
  resultsCount Int      @default(0) // How many results were returned
  fromCache    Boolean  @default(false)
  searchedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([searchedAt])
  @@index([company])
}

model OutreachTracker {
  id     String @id @default(cuid())
  userId String

  // Contact info
  contactEmail String
  contactName  String?
  company      String?
  role         String?
  location     String?
  linkedinUrl  String?

  // Links
  userCandidateId String? @unique
  gmailThreadId   String?

  // Dates
  dateEmailed        DateTime?
  responseReceivedAt DateTime?
  followedUpAt       DateTime?

  // Interaction
  spokeToThem     Boolean         @default(false)
  interactionType InteractionType @default(NONE)
  interactionDate DateTime?

  // Status & Notes
  status OutreachStatus @default(NOT_STARTED)
  notes  String?        @db.Text

  // Reminder
  reminderDate DateTime?
  reminderNote String?
  reminderSent Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCandidate UserCandidate? @relation(fields: [userCandidateId], references: [id], onDelete: SetNull)
  sendLogs      SendLog[]      @relation("OutreachSendLogs")

  @@unique([userId, contactEmail])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, reminderDate])
}

model CompanyAlias {
  id            String   @id @default(cuid())
  canonicalName String // "Procter & Gamble"
  aliases       String[] // ["p&g", "procter & gamble", "procter and gamble"]
  source        String   @default("LLM") // "LLM" or "MANUAL"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([canonicalName])
}

enum GroqAction {
  EMAIL_GENERATION
  EMAIL_REFINEMENT
  PERSONALIZATION
  PERSONALIZATION_FOUND_INFO
  FOLLOW_UP
  RESUME_PARSE
  COMPANY_ALIAS
  CALENDAR_PARSE
  CALENDAR_THREAD_PARSE
  SEARCH_FILTER_EXTRACTION
  DRAFTER_GAP_ANALYSIS
  DRAFTER_GENERATION
  DRAFTER_REFINEMENT
  PERSON_INSIGHT_EXTRACTION
}

model GroqUsageLog {
  id               String     @id @default(cuid())
  userId           String?
  action           GroqAction
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  durationMs       Int?
  error            Boolean    @default(false)
  createdAt        DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model CompanyResearch {
  id            String   @id @default(cuid())
  company       String
  role          String   @default("")
  talkingPoints Json
  rawResponse   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([company, role])
  @@index([company])
}

enum ReferralLinkType {
  AMBASSADOR
  QR_CODE
}

model ReferralLink {
  id          String           @id @default(cuid())
  code        String           @unique
  type        ReferralLinkType
  label       String
  userId      String?
  isActive    Boolean          @default(true)
  clickCount  Int              @default(0)
  signupCount Int              @default(0)
  paidCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now())

  user    User?  @relation("ReferralLinkCreator", fields: [userId], references: [id])
  signups User[] @relation("UserReferralLink")

  @@index([type])
}

model PersonInsight {
  id          String   @id @default(cuid())
  personId    String
  label       String
  detail      String
  type        String   // career | education | project | achievement | interest
  source      String   // linkedin | google | website | database
  confidence  String   // high | medium
  sourceUrl   String?  // URL where this fact was found
  extractedAt DateTime @default(now())
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}
